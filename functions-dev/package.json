{
  "name": "functions-dev",
  "private": true,
  "description": "Dev Cloud Functions codebase. Listens to the riverbusiness-dev Firestore database. Deploy with firebase deploy --only functions:dev",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "npm --prefix ../functions run build && node scripts/prepare.js",
    "lint": "node --check index.js && node --check scripts/prepare.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "date-fns": "^3.6.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0"
  }
}
