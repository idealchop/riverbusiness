rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      // User is an admin if their custom claim 'admin' is true, or their email is the designated admin email.
      return request.auth.token.admin == true || request.auth.token.email == 'admin@riverph.com';
    }

    function isSameCompany(companyId) {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.companyId == companyId ||
        isAdmin()
      );
    }

    // --- SHARED CLOUD STORAGE ---
    // Allow public read to support shareable links and frictionless team collaboration.
    // Allow any authenticated user to write/upload to facilitate an open organizational drive.
    match /cloud_storage/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSameCompany(companyId);
    }

    // --- COLLABORATION ASSETS ---
    // Strictly enforced organizational isolation for images embedded in documents.
    match /collab_images/{companyId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isSameCompany(companyId);
    }

    // --- FLEXIBLE ASSETS ---
    // Allow users to manage their own specific profile and chat assets.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    match /chats/{userId}/{allPaths=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    // --- SECURE ADMINISTRATIVE ASSETS ---
    // Only admins can manage official station documents, contracts, and internal uploads.
    match /admin_uploads/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /userContracts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /stations/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // --- PUBLIC MARKETING ASSETS ---
    match /Sales Portal/{allPaths=**} {
      allow read: if true;
    }
    match /River Mobile/{allPaths=**} {
      allow read: if true;
    }

    // Fallback rule: any authenticated user can read, only admins can write to root/other paths
    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
