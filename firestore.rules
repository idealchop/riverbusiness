rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@riverph.com' || 
        request.auth.token.admin == true
      );
    }

    // --- GLOBAL RULES ---

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- USER PROFILES & DIRECTORY ---

    match /users/{document=**} {
      // Unrestricted access for all signed-in members to facilitate collaboration and presence
      allow read, write: if isAuthenticated();
    }
    
    // --- CLOUD STORAGE APP (SHARED DRIVE) ---

    match /cloud_files/{document=**} {
      // Unrestricted organizational access: any signed-in user can manage files
      allow read, write: if isAuthenticated();
    }

    match /cloud_folders/{document=**} {
      // Unrestricted organizational access: any signed-in user can manage folders
      allow read, write: if isAuthenticated();
    }

    // --- INVITATIONS & ONBOARDING ---

    match /unclaimedProfiles/{document=**} {
      allow read, write: if isAuthenticated();
    }

    match /unclaimedEmployees/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // --- HR MULTI-TENANT DATA ---

    match /hr_companies/{document=**} {
      allow read, write: if isAuthenticated();
    }

    // --- COLLABORATION PLATFORM ---

    match /collaboration_pages/{pageId} {
      allow get: if isAuthenticated() || resource.data.isPublic == true;
      allow list: if isAuthenticated() || resource.data.isPublic == true;
      allow create, update, delete: if isAuthenticated();

      match /presence/{userId} {
        allow read, write: if isAuthenticated();
      }
    }
    
    match /collaboration_workspaces/{document=**} {
        allow read, write: if isAuthenticated();
    }

    match /collaboration_snapshots/{snapshotId} {
        allow read, create, delete: if isAuthenticated();
    }

    // --- STATION & COMPLIANCE ---

    match /waterStations/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /publicSanitationLinks/{linkId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // One editable app review per signed-in user. Clients cannot list the collection.
    // Assumed fields: userId (uid), rating 1-5 int, comment string <= 500, createdAt, updatedAt timestamps.
    match /appFeedback/{userId} {
      function validFeedback() {
        let data = request.resource.data;
        return data.keys().hasOnly(['userId', 'rating', 'comment', 'createdAt', 'updatedAt'])
          && data.userId == userId
          && data.userId == request.auth.uid
          && data.rating is int
          && data.rating >= 1
          && data.rating <= 5
          && data.comment is string
          && data.comment.size() <= 500
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
      }

      allow get: if isAuthenticated() && request.auth.uid == userId;
      allow create: if isAuthenticated() && request.auth.uid == userId && validFeedback();
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && validFeedback()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete, list: if false;
    }
  }
}