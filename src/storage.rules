rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.admin == true || request.auth.token.email == 'admin@riverph.com';
    }

    function underFileLimit() {
      return request.resource.size < 500 * 1024 * 1024;
    }

    match /workspaces/{companyId}/files/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && underFileLimit();
    }

    match /cloud_storage/{companyId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && underFileLimit();
    }

    match /collab_images/{companyId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /users/{userId}/collab_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    match /chats/{userId}/{allPaths=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }
    
    match /admin_uploads/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /userContracts/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    match /stations/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /{folder}/{allPaths=**} {
      allow read: if folder == 'Sales Portal' || folder == 'River Mobile';
    }

    match /{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
